# Copy this file to `.env` and fill in your token. `.env` is git-ignored.
#
# TMDB v4 "Read Access Token" (Settings -> API on themoviedb.org).
# It starts with "eyJ..." and is a long JWT-style string.
VITE_TMDB_TOKEN=

# Google OAuth client ID for Drive sync (Google Cloud Console -> Credentials).
# Ends with ".apps.googleusercontent.com". This value is public by design.
VITE_GOOGLE_CLIENT_ID=
