# Copy this file to `.env` and fill in your token. `.env` is git-ignored.
#
# TMDB v4 "Read Access Token" (Settings -> API on themoviedb.org).
# It starts with "eyJ..." and is a long JWT-style string.
VITE_TMDB_TOKEN=

# Google OAuth client ID for Drive sync (Google Cloud Console -> Credentials).
# Ends with ".apps.googleusercontent.com". This value is public by design.
VITE_GOOGLE_CLIENT_ID=

# Trakt API (reviews/discussion on detail pages). Create an app at
# trakt.tv/oauth/applications. Use redirect URI "urn:ietf:wg:oauth:2.0:oob".
# The client ID alone enables reading reviews; the secret enables sign-in
# (posting, liking, replying) via the OAuth device flow.
VITE_TRAKT_CLIENT_ID=
VITE_TRAKT_CLIENT_SECRET=

# Web Push "airing soon" notifications (optional — see worker/README.md).
# VAPID public key (base64url) from `npx web-push generate-vapid-keys`, and the
# deployed Cloudflare Worker URL. Both are public. Leave blank to fall back to
# in-app-only notifications.
VITE_VAPID_PUBLIC=
VITE_PUSH_API=
